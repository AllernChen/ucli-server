generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN
  ORG_ADMIN
  MEMBER
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum UsageGroupType {
  DEPARTMENT
  PROJECT
  REGION
}

enum OrgUnitType {
  EXECUTIVE
  FUNCTIONAL
  REGION
  LEGACY_PROJECT
}

enum GroupBudgetMode {
  TOTAL
  MONTHLY
}

enum ProjectStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ProjectCategory {
  BUSINESS
  DEPARTMENT
}

enum ProjectMemberRole {
  OWNER
  CONTRIBUTOR
  VIEWER
}

enum GroupMemberRole {
  LEADER
  MEMBER
}

enum BudgetApplicationStatus {
  REGISTERED
  LINKED
  REJECTED
}

enum CredentialType {
  DEVICE
  API_KEY
}

enum BudgetEntryKind {
  REQUEST
  LIMIT_ADJUSTMENT
  COST_ADJUSTMENT
}

enum BudgetEntryStatus {
  RESERVED
  SETTLED
  RELEASED
  RECONCILIATION_REQUIRED
}

enum BillingState {
  CONFIRMED
  ESTIMATED
  UNKNOWN
  NO_CHARGE
}

enum ChannelProtocol {
  OPENAI
  ANTHROPIC
  GEMINI
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
  DISABLED
}

enum ModelHealthStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  UNHEALTHY
  DISABLED
}

enum KeySelection {
  ROUND_ROBIN
  WEIGHTED_RANDOM
}

enum GatewayProtocol {
  OPENAI_RESPONSES
  OPENAI_CHAT
  ANTHROPIC_MESSAGES
  GEMINI
}

enum UsageSource {
  UPSTREAM
  ESTIMATED
}

enum SkillVersionStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
  REVOKED
}

enum SkillVisibility {
  GLOBAL
  ORGANIZATIONS
}

enum ReportPeriod {
  DAY
  WEEK
  MONTH
  QUARTER
  YEAR
}

enum ReportScope {
  PLATFORM
  ORGANIZATION
  ACCOUNT
  MODEL
  CHANNEL
}

model Organization {
  requireDeviceGroup Boolean @default(false) @map("require_device_group")
  usageGroups UsageGroup[]
  id           String              @id @default(uuid()) @db.Uuid
  slug         String              @unique
  name         String
  timezone     String              @default("UTC")
  enabled      Boolean             @default(true)
  createdAt    DateTime            @default(now()) @map("created_at")
  memberships  Membership[]
  devices      Device[]
  deviceGrants DeviceGrant[]
  quotas       QuotaPolicy[]
  logs         UsageLog[]
  skillScopes  SkillOrganization[]
  projects     Project[]

  @@map("organizations")
}

model Account {
  createdEmployeeKeys EmployeeApiKey[] @relation("EmployeeKeyCreator")
  budgetAdjustments GroupBudgetEntry[] @relation("BudgetActor")
  decidedApplications GroupBudgetApplication[] @relation("ApplicationDecider")
  projectBudgetAdjustments ProjectBudgetEntry[] @relation("ProjectBudgetActor")
  decidedProjectBudgetApplications ProjectBudgetApplication[] @relation("ProjectBudgetApplicationDecider")
  id                  String                @id @default(uuid()) @db.Uuid
  email               String                @unique
  displayName         String                @map("display_name")
  passwordHash String? @map("password_hash")
  pendingCredentialChange Boolean @default(false) @map("pending_credential_change")
  status              AccountStatus         @default(ACTIVE)
  tokenVersion        Int                   @default(1) @map("token_version")
  createdAt           DateTime              @default(now()) @map("created_at")
  memberships         Membership[]
  devices             Device[]
  deviceGrants        DeviceGrant[]         @relation("GrantAccount")
  createdDeviceGrants DeviceGrant[]         @relation("GrantCreator")
  createdDeviceGrantLinks DeviceGrantLink[] @relation("DeviceGrantLinkCreator")
  quotas              QuotaPolicy[]
  logs                UsageLog[]
  audits              AuditLog[]

  @@map("accounts")
}

model Membership {
  groupMemberships GroupMember[]
  employeeKeys EmployeeApiKey[]
  budgetEntries GroupBudgetEntry[]
  budgetApplications GroupBudgetApplication[]
  projectMemberships ProjectMember[]
  projectBudgetEntries ProjectBudgetEntry[]
  projectBudgetApplications ProjectBudgetApplication[]
  organizationId String       @map("organization_id") @db.Uuid
  accountId      String       @map("account_id") @db.Uuid
  role           Role
  status         AccountStatus @default(ACTIVE)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([organizationId, accountId])
  @@map("memberships")
}

model Device {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  accountId        String       @map("account_id") @db.Uuid
  name             String
  installationId   String?      @map("installation_id") @db.Uuid
  platform         String?
  clientVersion    String?      @map("client_version")
  refreshTokenHash String       @unique @map("refresh_token_hash")
  revokedAt        DateTime?    @map("revoked_at")
  lastSeenAt       DateTime?    @map("last_seen_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account          Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  grant            DeviceGrant?
  logs             UsageLog[]

  @@index([organizationId, accountId])
  @@map("devices")
}

model DeviceGrant {
  groupId String? @map("group_id") @db.Uuid
  group UsageGroup? @relation(fields: [groupId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  projectId String? @map("project_id") @db.Uuid
  project Project? @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  accountId        String       @map("account_id") @db.Uuid
  expiresAt        DateTime?    @map("expires_at")
  disabledAt       DateTime?    @map("disabled_at")
  deletedAt        DateTime?    @map("deleted_at")
  boundAt          DateTime?    @map("bound_at")
  redeemRetryUntil DateTime?    @map("redeem_retry_until")
  deviceId         String?      @unique @map("device_id") @db.Uuid
  createdById      String       @map("created_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account          Account      @relation("GrantAccount", fields: [accountId], references: [id], onDelete: Cascade)
  createdBy        Account      @relation("GrantCreator", fields: [createdById], references: [id])
  device           Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  links            DeviceGrantLink[]

  @@index([organizationId, accountId, createdAt])
  @@index([organizationId, deletedAt, expiresAt])
  @@index([organizationId, projectId])
  @@map("device_grants")
}

model DeviceGrantLink {
  id              String      @id @default(uuid()) @db.Uuid
  deviceGrantId   String      @map("device_grant_id") @db.Uuid
  secretHash      String      @unique @map("secret_hash")
  secretEncrypted Json?       @map("secret_encrypted")
  secretHint      String      @map("secret_hint")
  expiresAt       DateTime?   @map("expires_at")
  revokedAt       DateTime?   @map("revoked_at")
  consumedAt      DateTime?   @map("consumed_at")
  createdById     String      @map("created_by_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")
  issuanceOrder   BigInt      @unique @default(autoincrement()) @map("issuance_order")
  deviceGrant     DeviceGrant @relation(fields: [deviceGrantId], references: [id], onDelete: Cascade)
  createdBy       Account     @relation("DeviceGrantLinkCreator", fields: [createdById], references: [id])

  @@index([deviceGrantId, createdAt])
  @@index([deviceGrantId, issuanceOrder])
  @@map("device_grant_links")
}

model Channel {
  id               String          @id @default(uuid()) @db.Uuid
  name             String
  provider         String
  protocol         ChannelProtocol
  baseUrl          String          @map("base_url")
  modelDiscoveryUrl String?         @map("model_discovery_url")
  priority         Int             @default(0)
  weight           Int             @default(1)
  enabled          Boolean         @default(true)
  autoDisable      Boolean         @default(true) @map("auto_disable")
  timeoutMs        Int             @default(300000) @map("timeout_ms")
  maxRetries       Int             @default(1) @map("max_retries")
  keySelection     KeySelection    @default(WEIGHTED_RANDOM) @map("key_selection")
  costTimezone     String          @default("UTC") @map("cost_timezone")
  health           HealthStatus    @default(HEALTHY)
  circuitOpenUntil DateTime?       @map("circuit_open_until")
  lastTestedAt     DateTime?       @map("last_tested_at")
  lastSuccessAt    DateTime?       @map("last_success_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  deletedAt        DateTime?       @map("deleted_at")
  keys             ChannelKey[]
  channelModels    ChannelModel[]
  routes           RouteAttempt[]
  logs             UsageLog[]
  reports          Report[]

  @@index([enabled, health, priority])
  @@index([deletedAt, enabled])
  @@map("channels")
}

model ChannelKey {
  id            String         @id @default(uuid()) @db.Uuid
  channelId     String         @map("channel_id") @db.Uuid
  ciphertext    String
  iv            String
  tag           String
  suffix        String
  priority      Int            @default(0)
  weight        Int            @default(1)
  enabled       Boolean        @default(true)
  health        HealthStatus   @default(HEALTHY)
  remainingUsd  Decimal?       @map("remaining_usd") @db.Decimal(20, 8)
  expiresAt     DateTime?      @map("expires_at")
  isolatedUntil DateTime?      @map("isolated_until")
  lastUsedAt    DateTime?      @map("last_used_at")
  deletedAt     DateTime?      @map("deleted_at")
  channel       Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  routes        RouteAttempt[]

  @@index([channelId, enabled, health])
  @@index([deletedAt, enabled])
  @@map("channel_keys")
}

model PublicModel {
  groupAccess GroupModelAccess[]
  id              String              @id
  displayName     String              @map("display_name")
  manufacturer    String              @default("未分类")
  manufacturerKey String              @default("未分类") @map("manufacturer_key")
  enabled         Boolean             @default(false)
  contextSize     Int?                @map("context_size")
  deletedAt       DateTime?           @map("deleted_at")
  channelModels   ChannelModel[]
  prices          ModelPriceVersion[]
  policies        ModelAccessPolicy[]
  quotas          QuotaPolicy[]
  logs            UsageLog[]
  reports         Report[]

  @@index([deletedAt, enabled])
  @@index([manufacturerKey, deletedAt, enabled], map: "public_models_manufacturer_lifecycle_idx")
  @@map("public_models")
}

model ChannelModel {
  id                   String                 @id @default(uuid()) @db.Uuid
  channelId            String                 @map("channel_id") @db.Uuid
  publicModelId        String                 @map("public_model_id")
  upstreamModel        String                 @map("upstream_model")
  protocol             GatewayProtocol
  supportsStream       Boolean                @default(true) @map("supports_stream")
  supportsTools        Boolean                @default(true) @map("supports_tools")
  enabled              Boolean                @default(true)
  health               ModelHealthStatus      @default(UNKNOWN)
  consecutiveFailures  Int                    @default(0) @map("consecutive_failures")
  probeEnabled         Boolean                @default(true) @map("probe_enabled")
  probeIntervalMinutes Int                    @default(15) @map("probe_interval_minutes")
  lastTestedAt         DateTime?              @map("last_tested_at")
  lastSuccessAt        DateTime?              @map("last_success_at")
  lastErrorCode        String?                @map("last_error_code")
  deletedAt            DateTime?              @map("deleted_at")
  channel              Channel                @relation(fields: [channelId], references: [id], onDelete: Cascade)
  publicModel          PublicModel            @relation(fields: [publicModelId], references: [id], onDelete: Cascade)
  costRules            ChannelModelCostRule[]
  probes               ChannelModelProbe[]
  logs                 UsageLog[]

  @@unique([channelId, publicModelId, protocol])
  @@index([publicModelId, protocol, enabled, health])
  @@index([deletedAt, enabled])
  @@map("channel_models")
}

model ChannelModelCostRule {
  id                  String       @id @default(uuid()) @db.Uuid
  channelModelId      String       @map("channel_model_id") @db.Uuid
  name                String
  daysOfWeek          Int[]        @map("days_of_week")
  startMinute         Int          @map("start_minute")
  endMinute           Int          @map("end_minute")
  priority            Int          @default(0)
  inputPerMillion     Decimal      @map("input_per_million") @db.Decimal(20, 8)
  outputPerMillion    Decimal      @map("output_per_million") @db.Decimal(20, 8)
  cachedPerMillion    Decimal      @default(0) @map("cached_per_million") @db.Decimal(20, 8)
  reasoningPerMillion Decimal      @default(0) @map("reasoning_per_million") @db.Decimal(20, 8)
  currency            String       @default("CNY")
  enabled             Boolean      @default(true)
  validFrom           DateTime     @map("valid_from")
  validUntil          DateTime?    @map("valid_until")
  createdAt           DateTime     @default(now()) @map("created_at")
  deletedAt           DateTime?    @map("deleted_at")
  channelModel        ChannelModel @relation(fields: [channelModelId], references: [id], onDelete: Cascade)
  logs                UsageLog[]

  @@index([channelModelId, enabled, validFrom])
  @@index([channelModelId, deletedAt, enabled, validFrom], map: "cm_cost_rules_lifecycle_idx")
  @@map("channel_model_cost_rules")
}

model ChannelModelProbe {
  id             String            @id @default(uuid()) @db.Uuid
  channelModelId String            @map("channel_model_id") @db.Uuid
  source         String
  health         ModelHealthStatus
  statusCode     Int?              @map("status_code")
  latencyMs      Int               @map("latency_ms")
  firstTokenMs   Int?              @map("first_token_ms")
  errorCode      String?           @map("error_code")
  keySuffix      String?           @map("key_suffix")
  testedAt       DateTime          @default(now()) @map("tested_at")
  channelModel   ChannelModel      @relation(fields: [channelModelId], references: [id], onDelete: Cascade)

  @@index([channelModelId, testedAt])
  @@map("channel_model_probes")
}

model ModelPriceVersion {
  id                  String      @id @default(uuid()) @db.Uuid
  publicModelId       String      @map("public_model_id")
  inputPerMillion     Decimal     @map("input_per_million") @db.Decimal(20, 8)
  outputPerMillion    Decimal     @map("output_per_million") @db.Decimal(20, 8)
  cachedPerMillion    Decimal     @default(0) @map("cached_per_million") @db.Decimal(20, 8)
  reasoningPerMillion Decimal     @default(0) @map("reasoning_per_million") @db.Decimal(20, 8)
  currency            String      @default("CNY")
  enabled             Boolean     @default(true)
  validFrom           DateTime    @map("valid_from")
  validUntil          DateTime?   @map("valid_until")
  deletedAt           DateTime?   @map("deleted_at")
  publicModel         PublicModel @relation(fields: [publicModelId], references: [id], onDelete: Cascade)
  logs                UsageLog[]

  @@index([publicModelId, validFrom])
  @@index([publicModelId, deletedAt, validFrom], map: "model_prices_lifecycle_idx")
  @@index([publicModelId, deletedAt, enabled, validFrom], map: "model_prices_runtime_idx")
  @@map("model_price_versions")
}

model ModelAccessPolicy {
  id             String      @id @default(uuid()) @db.Uuid
  publicModelId  String      @map("public_model_id")
  organizationId String?     @map("organization_id") @db.Uuid
  accountId      String?     @map("account_id") @db.Uuid
  role           Role?
  publicModel    PublicModel @relation(fields: [publicModelId], references: [id], onDelete: Cascade)

  @@index([publicModelId, organizationId, accountId])
  @@map("model_access_policies")
}

model QuotaPolicy {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  accountId      String?       @map("account_id") @db.Uuid
  publicModelId  String?       @map("public_model_id")
  dailyTokens    BigInt?       @map("daily_tokens")
  monthlyTokens  BigInt?       @map("monthly_tokens")
  dailyCostUsd   Decimal?      @map("daily_cost_usd") @db.Decimal(20, 8)
  monthlyCostUsd Decimal?      @map("monthly_cost_usd") @db.Decimal(20, 8)
  qps            Int?
  tpm            BigInt?
  concurrency    Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        Account?      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  publicModel    PublicModel?  @relation(fields: [publicModelId], references: [id], onDelete: Cascade)

  @@index([organizationId, accountId, publicModelId])
  @@map("quota_policies")
}

model UsageLog {
  groupId String? @map("group_id") @db.Uuid
  apiKeyId String? @map("api_key_id") @db.Uuid
  budgetProjectId String? @map("budget_project_id") @db.Uuid
  credentialType CredentialType @default(DEVICE) @map("credential_type")
  actorSnapshot Json? @map("actor_snapshot")
  group UsageGroup? @relation(fields: [groupId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  apiKey EmployeeApiKey? @relation(fields: [apiKeyId, organizationId, accountId, groupId], references: [id, organizationId, accountId, groupId], onDelete: Restrict, onUpdate: Restrict)
  budgetProject Project? @relation(fields: [budgetProjectId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  id                String                @id @default(uuid()) @db.Uuid
  requestId         String                @unique @map("request_id")
  organizationId    String                @map("organization_id") @db.Uuid
  accountId         String                @map("account_id") @db.Uuid
  deviceId          String?               @map("device_id") @db.Uuid
  sessionId         String?               @map("session_id") @db.Uuid
  projectId         String?               @map("project_id") @db.Uuid
  cliType           String?               @map("cli_type")
  clientVersion     String?               @map("client_version")
  timezone          String?
  protocol          GatewayProtocol
  publicModelId     String                @map("public_model_id")
  upstreamModel     String                @map("upstream_model")
  channelId         String                @map("channel_id") @db.Uuid
  channelModelId    String?               @map("channel_model_id") @db.Uuid
  priceVersionId    String?               @map("price_version_id") @db.Uuid
  channelCostRuleId String?               @map("channel_cost_rule_id") @db.Uuid
  costSnapshot      Json?                 @map("cost_snapshot")
  startedAt         DateTime              @map("started_at")
  finishedAt        DateTime              @map("finished_at")
  durationMs        Int                   @map("duration_ms")
  firstTokenMs      Int?                  @map("first_token_ms")
  inputTokens       BigInt                @default(0) @map("input_tokens")
  outputTokens      BigInt                @default(0) @map("output_tokens")
  cachedTokens      BigInt                @default(0) @map("cached_tokens")
  reasoningTokens   BigInt                @default(0) @map("reasoning_tokens")
  costUsd           Decimal               @default(0) @map("cost_usd") @db.Decimal(20, 8)
  usageSource       UsageSource           @map("usage_source")
  streaming         Boolean
  statusCode        Int                   @map("status_code")
  errorCode         String?               @map("error_code")
  providerErrorType String?               @map("provider_error_type")
  routeAttempts     Int                   @default(1) @map("route_attempts")
  switched          Boolean               @default(false)
  clientCancelled   Boolean               @default(false) @map("client_cancelled")
  streamInterrupted Boolean               @default(false) @map("stream_interrupted")
  organization      Organization          @relation(fields: [organizationId], references: [id])
  account           Account               @relation(fields: [accountId], references: [id])
  device            Device?               @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  channel           Channel               @relation(fields: [channelId], references: [id])
  channelModel      ChannelModel?         @relation(fields: [channelModelId], references: [id], onDelete: SetNull)
  publicModel       PublicModel           @relation(fields: [publicModelId], references: [id])
  priceVersion      ModelPriceVersion?    @relation(fields: [priceVersionId], references: [id])
  channelCostRule   ChannelModelCostRule? @relation(fields: [channelCostRuleId], references: [id], onDelete: SetNull)
  routes            RouteAttempt[]

  @@index([organizationId, startedAt])
  @@index([accountId, startedAt])
  @@index([publicModelId, startedAt])
  @@index([channelId, startedAt])
  @@index([organizationId, startedAt, channelId])
  @@index([organizationId, startedAt, publicModelId])
  @@index([organizationId, startedAt, accountId])
  @@index([organizationId, startedAt, channelModelId])
  @@index([sessionId, startedAt])
  @@index([organizationId, groupId, startedAt])
  @@index([apiKeyId, startedAt])
  @@index([organizationId, budgetProjectId, startedAt], map: "usage_logs_budget_project_time_idx")
  @@map("usage_logs")
}

model RouteAttempt {
  costCny Decimal? @map("cost_cny") @db.Decimal(20, 8)
  usageSnapshot Json? @map("usage_snapshot")
  billingState BillingState? @map("billing_state")
  id           String      @id @default(uuid()) @db.Uuid
  usageLogId   String      @map("usage_log_id") @db.Uuid
  channelId    String      @map("channel_id") @db.Uuid
  channelKeyId String?     @map("channel_key_id") @db.Uuid
  attempt      Int
  startedAt    DateTime    @map("started_at")
  durationMs   Int         @map("duration_ms")
  statusCode   Int?        @map("status_code")
  errorType    String?     @map("error_type")
  usageLog     UsageLog    @relation(fields: [usageLogId], references: [id], onDelete: Cascade)
  channel      Channel     @relation(fields: [channelId], references: [id])
  channelKey   ChannelKey? @relation(fields: [channelKeyId], references: [id])

  @@index([usageLogId, attempt])
  @@map("route_attempts")
}

model UsageAggregate {
  id             String   @id @default(uuid()) @db.Uuid
  bucket         String
  bucketStart    DateTime @map("bucket_start")
  organizationId String?  @map("organization_id") @db.Uuid
  accountId      String?  @map("account_id") @db.Uuid
  publicModelId  String?  @map("public_model_id")
  channelId      String?  @map("channel_id") @db.Uuid
  requests       BigInt
  successes      BigInt
  inputTokens    BigInt   @map("input_tokens")
  outputTokens   BigInt   @map("output_tokens")
  costUsd        Decimal  @map("cost_usd") @db.Decimal(20, 8)
  avgDurationMs  Int      @map("avg_duration_ms")

  @@unique([bucket, bucketStart, organizationId, accountId, publicModelId, channelId])
  @@index([bucket, bucketStart])
  @@map("usage_aggregates")
}

model Skill {
  id          String         @id @default(uuid()) @db.Uuid
  slug        String         @unique
  name        String
  description String
  createdAt   DateTime       @default(now()) @map("created_at")
  versions    SkillVersion[]

  @@map("skills")
}

model SkillVersion {
  id            String              @id @default(uuid()) @db.Uuid
  skillId       String              @map("skill_id") @db.Uuid
  version       String
  status        SkillVersionStatus  @default(DRAFT)
  visibility    SkillVisibility     @default(GLOBAL)
  objectKey     String              @map("object_key")
  sha256        String
  sizeBytes     BigInt              @map("size_bytes")
  manifest      Json
  fileManifest  Json                @map("file_manifest")
  scanResult    Json                @map("scan_result")
  publishedAt   DateTime?           @map("published_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  skill         Skill               @relation(fields: [skillId], references: [id], onDelete: Cascade)
  organizations SkillOrganization[]

  @@unique([skillId, version])
  @@map("skill_versions")
}

model SkillOrganization {
  skillVersionId String       @map("skill_version_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  skillVersion   SkillVersion @relation(fields: [skillVersionId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([skillVersionId, organizationId])
  @@map("skill_organizations")
}

model Report {
  id             String       @id @default(uuid()) @db.Uuid
  period         ReportPeriod
  scope          ReportScope
  scopeId        String?      @map("scope_id")
  organizationId String?      @map("organization_id") @db.Uuid
  accountId      String?      @map("account_id") @db.Uuid
  publicModelId  String?      @map("public_model_id")
  channelId      String?      @map("channel_id") @db.Uuid
  rangeStart     DateTime     @map("range_start")
  rangeEnd       DateTime     @map("range_end")
  markdown       String
  metrics        Json
  createdAt      DateTime     @default(now()) @map("created_at")

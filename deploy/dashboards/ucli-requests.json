{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "当前 QPS",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" } },
      "targets": [{ "refId": "A", "expr": "sum(rate(ucli_http_requests_total[$__rate_interval]))", "datasource": { "type": "prometheus", "uid": "prometheus" } }]
    },
    {
      "type": "stat",
      "title": "P95 延迟",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" } },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(ucli_http_request_duration_seconds_bucket[$__rate_interval])))", "datasource": { "type": "prometheus", "uid": "prometheus" } }]
    },
    {
      "type": "stat",
      "title": "5xx 错误率",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.05 }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" } },
      "targets": [{ "refId": "A", "expr": "sum(rate(ucli_http_requests_total{status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(ucli_http_requests_total[$__rate_interval])), 1e-9)", "datasource": { "type": "prometheus", "uid": "prometheus" } }]
    },
    {
      "type": "timeseries",
      "title": "QPS 按路由",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never", "lineInterpolation": "smooth" } },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "sum by (job, route) (rate(ucli_http_requests_total[$__rate_interval]))", "legendFormat": "{{job}} {{route}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }]
    },
    {
      "type": "timeseries",
      "title": "P95 延迟按路由",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never", "lineInterpolation": "smooth" } },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, job, route) (rate(ucli_http_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{job}} {{route}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }]
    },
    {
      "type": "timeseries",
      "title": "状态码分布",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never", "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "sum by (status_code) (rate(ucli_http_requests_total[$__rate_interval]))", "legendFormat": "{{status_code}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["ucli", "requests"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "UCLI 请求监控",
  "uid": "ucli-requests",
  "version": 1
}

# Deployment identity. Image archives in images/ must use the same version.
PROJECT_NAME=ucli-server
VERSION=0.3.1

# Public HTTP entry point.
HTTP_PORT=80
PUBLIC_URL=http://10.44.100.100
GATEWAY_PUBLIC_URL=http://10.44.100.100/gateway
ADMIN_ORIGIN=http://10.44.100.100

# Existing PostgreSQL on Docker network config_default.
DATABASE_URL=postgresql://<user>:<password>@portrait-postgres:5432/ucli

# Existing Redis on Docker network config_default.
REDIS_URL=redis://portrait-redis:6379

# Existing MinIO on Docker network ai-bot-cowork-deploy.
MINIO_ENDPOINT=ai-bot-cowork-minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=<access-key>
MINIO_SECRET_KEY=<secret-key>
MINIO_SKILLS_BUCKET=ucli-skills

# Generate independent production secrets; never reuse example values.
JWT_SECRET=<at-least-32-random-characters>
SETUP_SECRET=<one-time-bootstrap-secret>
MASTER_KEY=<base64-encoded-32-byte-key>

# Optional internal quota alert webhook.
QUOTA_ALERT_WEBHOOK_URL=
NO_COLOR=1

# === 基础设施（本地 dev 用；完整部署用容器内 DSN，见 docker-compose.yml） ===
POSTGRES_PASSWORD=replace-with-strong-password
# 本地 dev（docker-compose.dev.yml）:
DATABASE_URL=postgresql://ucli:replace-with-strong-password@localhost:5432/ucli
REDIS_URL=redis://localhost:6381

MINIO_ROOT_USER=ucli
MINIO_ROOT_PASSWORD=replace-with-strong-password
# 本地 dev（docker-compose.dev.yml，避开本机其它项目端口）:
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_ACCESS_KEY=ucli
MINIO_SECRET_KEY=replace-with-strong-password

# === 应用密钥 ===
JWT_SECRET=replace-with-at-least-32-random-characters
# 初始化管理员后应轮换
SETUP_SECRET=replace-with-one-time-bootstrap-secret
# Generate with: openssl rand -base64 32
MASTER_KEY=replace-with-base64-encoded-32-byte-key

# === 对外地址 ===
PUBLIC_URL=http://localhost
GATEWAY_PUBLIC_URL=http://localhost/gateway
# 管理后台 CORS 来源（逗号分隔，dev 是 vite 端口）
ADMIN_ORIGIN=http://localhost:5173,http://localhost:5174

# === 部署端口 ===
HTTP_PORT=80
GRAFANA_PORT=3002
GRAFANA_ADMIN_PASSWORD=replace-with-strong-password

# === 其它 ===
# 配额阈值告警 webhook（可选；50/80/100% 阈值触发时 POST JSON）
QUOTA_ALERT_WEBHOOK_URL=
# 禁用 NestJS 日志 ANSI 颜色（供 Loki 干净采集）
NO_COLOR=1
